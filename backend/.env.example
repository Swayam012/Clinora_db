# ===================================================
# CLINORA — Backend Environment Variables Configuration
# Copy this file to .env and configure your local/production settings.
# DO NOT commit real secrets or production credentials to git.
# ===================================================

PROJECT_NAME="CLINORA — Clinical Document Intelligence System"
API_V1_STR="/api/v1"

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="NewPassword123!"
POSTGRES_DB="clinora_db"
DATABASE_URL="postgresql://postgres:NewPassword123!@localhost:5432/clinora_db"

# CORS Configuration (comma-separated or JSON array of authorized origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# JWT Authentication Configuration
# Generate a secure 64-char secret in production using: openssl rand -hex 32
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Clinical Document Storage Configuration
UPLOAD_DIR="uploads/documents"
MAX_UPLOAD_SIZE_BYTES=26214400  # 25 MB

# OCR Engine Configuration
TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
OCR_DPI=300
OCR_CONFIDENCE_THRESHOLD=30.0

# LLM Clinical Extraction Configuration
# Obtain your free/production API key from https://aistudio.google.com/
GEMINI_API_KEY="your_google_gemini_api_key_here"
LLM_MODEL="gemini-2.5-flash"


