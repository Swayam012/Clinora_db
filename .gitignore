# ============================================
# Root .gitignore — Clinora
# ============================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Uploaded patient records & clinical files (HIPAA / Privacy)
uploads/
backend/uploads/
*.pdf
*.png
*.jpg
*.jpeg
*.tiff
*.webp

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.oxlintcache
.vite/
dist/
dist-ssr/

# Logs & temporary data
*.log
logs/
scratch/

# Vector DB & local persistent embeddings
chroma_db/
backend/chroma_db/
*.sqlite3
*.sqlite3-journal
*.bin


# OS / IDE
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
